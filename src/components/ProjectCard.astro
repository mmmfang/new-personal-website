---
const { project } = Astro.props;
---
<article class="project-card"><div><span class="eyebrow">{project.eyebrow}</span><h3>{project.title}</h3><p>{project.description}</p><p class="project-note">{project.note}</p></div><div class="phone-wrap"><img src={project.image} alt="One-Tap Transit accessible interface" loading="lazy"/></div></article>
