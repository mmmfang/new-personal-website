---
import '../styles/credential-proof.css'; import { siteContent } from '../data/siteContent';
const { credential } = siteContent;
---
<aside class="credential-proof" aria-labelledby="credential-title"><div class="credential-thumb"><img src={credential.image} alt="" loading="lazy"/></div><div><span>Continuous learning</span><h3 id="credential-title">{credential.title}</h3><small>{credential.issuer}</small></div><a href={credential.link} target="_blank" rel="noreferrer">View credential <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></aside>
