import '../styles/hero-comparisons.css'; import { siteContent } from '../data/siteContent'; const { hero } = siteContent;
---
<div class="hero-comparison-page">
  <section class="hero-option option-process page-shell" aria-labelledby="hero-process-title"><p class="option-label">Hero direction 2 · Strategy → Build → Measure</p><div class="option-grid"><div class="option-copy"><p class="eyebrow">Mae F. · Web strategist focused on AI & AEO</p><h1 id="hero-process-title">Web strategy for the AI search era.</h1><p>{hero.introduction}</p><div class="button-row"><a class="button primary" href="#projects">Explore selected work →</a><a class="text-link" href="#ai-search-lab">View AEO experiment ↓</a></div></div><div class="process-visual" aria-label="Mae's process from web strategy through building and measurement"><article class="process-card card-strategy"><span>01</span><small>Strategy</small><strong>Find the useful problem.</strong><p>Audience · Roadmap · UX</p></article><article class="process-card card-build"><span>02</span><small>Build</small><strong>Take it from concept to code.</strong><p>Design · CMS · Development</p></article><article class="process-card card-measure"><span>03</span><small>Measure</small><strong>Learn what happens next.</strong><p>Analytics · AI search · AEO</p></article><div class="process-thread" aria-hidden="true"></div></div></div></section>
  <section class="hero-option option-minimal" aria-labelledby="hero-minimal-title"><div class="page-shell"><p class="option-label">Hero direction 4 · Message first</p><div class="minimal-copy"><p class="eyebrow">Mae F. · Web strategist focused on AI & AEO</p><h1 id="hero-minimal-title">Building better websites for how people search now.</h1><p>{hero.introduction}</p><div class="button-row"><a class="button primary" href="#projects">Explore selected work →</a><a class="text-link" href="#ai-search-lab">View AEO experiment ↓</a></div></div><div class="proof-row" aria-label="Core areas of expertise"><span>Web strategy</span><span>From concept to code</span><span>AI product building</span><span>AEO experimentation</span></div></div><div class="minimal-wash" aria-hidden="true"></div></section>
</div>
