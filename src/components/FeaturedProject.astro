---
const { project } = Astro.props;
---
<article class="featured-project"><div class="featured-copy"><p class="eyebrow">{project.eyebrow}</p><h3>{project.title}</h3><p class="subtitle">{project.subtitle}</p><p>{project.description}</p><ul>{project.features.map((feature: string) => <li>{feature}</li>)}</ul><a class="button primary" href={project.link} target="_blank" rel="noreferrer">Open app <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div><div class="featured-visual"><div class="browser-top" aria-hidden="true"><i></i><i></i><i></i><span>sew-whats-next</span></div><img src={project.image} alt="Sew What’s Next dashboard showing project filters and a recommended pattern" loading="lazy"/></div></article>
