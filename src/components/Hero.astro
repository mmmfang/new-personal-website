---
import '../styles/hybrid.css'; import { siteContent } from '../data/siteContent'; const { hero } = siteContent;
---
<section class="hero page-shell hybrid-hero">
  <div class="hero-copy"><span class="eyebrow">Web strategy · AI search · AEO</span><p class="hero-name">{hero.name}</p><h1>{hero.headline}</h1><p class="hero-intro">{hero.introduction}</p><div class="button-row"><a class="button primary" href="#ai-search-lab">View AEO experiment <span aria-hidden="true">→</span></a><a class="text-link" href="#projects">Explore selected work <span aria-hidden="true">↓</span></a></div></div>
  <div class="hybrid-art" role="img" aria-label="Abstract watercolor artwork in a restrained wood frame"><div class="hybrid-paint lavender"></div><div class="hybrid-paint blush"></div><div class="hybrid-paint sage"></div><div class="hybrid-paint navy"></div><span class="botanical">❧</span></div>
</section>
