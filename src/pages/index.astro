---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import HeroMessageFirst from '../components/HeroMessageFirst.astro'; import FlagshipCaseStudy from '../components/FlagshipCaseStudy.astro'; import FocusCard from '../components/FocusCard.astro'; import FocusApproach from '../components/FocusApproach.astro'; import Footer from '../components/Footer.astro'; import { siteContent } from '../data/siteContent';
---
<BaseLayout><Header/><main id="main-content"><HeroMessageFirst/>
<section class="projects-section" id="projects"><div class="page-shell"><div class="section-heading split"><div><p class="eyebrow">Selected work</p><h2>Connecting audience needs, digital experiences, and discoverability.</h2></div><p>I connect audience needs, user experience, measurement, and hands-on implementation. Sew What’s Next brings those disciplines together in one live product.</p></div><FlagshipCaseStudy/></div></section>
<section class="focus-section page-shell" id="about"><div class="section-heading split"><div><p class="eyebrow">Professional focus</p><h2>The web expertise behind the experiments.</h2></div><p>I work across the full website lifecycle—from understanding the problem and organizing the experience to measuring what happens and building what comes next.</p></div><ul class="focus-grid" role="list">{siteContent.focusAreas.map((item,index)=><FocusCard {...item} number={`0${index+1}`}/>)}</ul><FocusApproach/></section>
<section class="contact-section" id="contact"><div class="page-shell contact-inner"><h2>Let’s stay connected.</h2><p>Follow along for notes on what’s working across AI, AEO, and digital experience.</p><a class="button light" href={siteContent.contact.linkedin} target="_blank" rel="noreferrer">Find me on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></section>
</main><Footer/></BaseLayout>
