---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import HeroMessageFirst from '../components/HeroMessageFirst.astro'; import FlagshipCaseStudy from '../components/FlagshipCaseStudy.astro'; import FocusCard from '../components/FocusCard.astro'; import FocusApproach from '../components/FocusApproach.astro'; import Footer from '../components/Footer.astro'; import { siteContent } from '../data/siteContent';
---
<BaseLayout><Header/><main id="main-content"><HeroMessageFirst/>
<section class="projects-section" id="projects"><div class="page-shell"><div class="section-heading split"><div><p class="eyebrow">Selected work</p><h2>Building useful products—and learning from what happens next.</h2></div><p>My work combines web strategy, user experience, measurement, and hands-on implementation. Sew What’s Next brings those disciplines together in one live product.</p></div><FlagshipCaseStudy/></div></section>
<section class="focus-section page-shell" id="about"><div class="section-heading split"><div><p class="eyebrow">Professional focus</p><h2>The web expertise behind the experiments.</h2></div><p>AEO is an extension of my broader practice: understanding audiences, structuring information, measuring performance, and turning strategy into working experiences.</p></div><div class="focus-grid">{siteContent.focusAreas.map((item,index)=><FocusCard {...item} number={`0${index+1}`}/>)}</div><FocusApproach/></section>
<section class="contact-section" id="contact"><div class="page-shell contact-inner"><p class="eyebrow">Web strategy, AI, and AEO</p><h2>Let’s stay connected.</h2><p>Follow along for notes on web strategy, AI search, AEO experiments, and what I’m building.</p><a class="button light" href={siteContent.contact.linkedin} target="_blank" rel="noreferrer">Find me on LinkedIn ↗</a></div></section>
</main><Footer/></BaseLayout>
